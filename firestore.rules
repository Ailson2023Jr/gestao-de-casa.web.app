rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: incomes
// Document ID: pattern 'inc-[0-9]+' or auto-generated string ID
// Fields:
//   - id: string (optional, 1-64 chars) - Identificador do lançamento
//   - description: string (required, 1-100 chars) - Descrição da receita (ex: "Salário", "Freelance")
//   - amount: number (required, > 0 and <= 100000000) - Valor monetário positivo da receita
//   - category: string (optional, 1-50 chars) - Categoria da receita (ex: "Salário", "Extra", "Outros")
//   - date: string (required, format YYYY-MM-DD or ISO 8601, 10-35 chars) - Data do recebimento
//   - uid: string (optional, 1-128 chars, immutable) - UID do usuário autenticado no Firebase Auth
//   - createdAt: timestamp | string (optional, immutable) - Data de criação do registro
//   - updatedAt: timestamp | string (optional) - Data de atualização do registro
//
// Collection: expenses
// Document ID: pattern 'exp-[0-9]+' or auto-generated string ID
// Fields:
//   - id: string (optional, 1-64 chars) - Identificador da despesa
//   - description: string (required, 1-100 chars) - Descrição da despesa (ex: "Aluguel", "Luz")
//   - amount: number (required, > 0 and <= 100000000) - Valor monetário positivo da conta/despesa
//   - dueDate: string (required, format YYYY-MM-DD or ISO 8601, 10-35 chars) - Data de vencimento
//   - category: string (optional, 1-50 chars) - Categoria da despesa (ex: "Moradia", "Serviços", "Alimentação", "Cartão", "Transporte", "Saúde", "Lazer", "Outros")
//   - paid: bool (optional, boolean) - Indicador se a despesa já foi paga ou está pendente
//   - paymentUrl: string (optional, 0-500 chars) - Link ou URL para pagamento/código de barras da conta
//   - uid: string (optional, 1-128 chars, immutable) - UID do usuário autenticado no Firebase Auth
//   - createdAt: timestamp | string (optional, immutable) - Data de criação do registro
//   - updatedAt: timestamp | string (optional) - Data de atualização do registro
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Prototype / domestic testing mode: enables open development access
    // Change to 'false' to enforce strict Firebase Authentication in production
    function isPrototypeMode() {
      return true;
    }

    // Access authorization check: allows authenticated users or open prototype mode
    function isAuthorized() {
      return isAuthenticated() || isPrototypeMode();
    }

    // Check if the authenticated user owns the document by matching UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user is the document owner via the 'uid' field
    function isDocOwner() {
      return isAuthenticated() && ('uid' in resource.data) && request.auth.uid == resource.data.uid;
    }

    // Verify that the UID field on create matches the authenticated user if specified
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
             (isAuthenticated() && request.resource.data.uid == request.auth.uid);
    }

    // Ensure UID field cannot be altered or hijacked on update
    function uidNotModified() {
      return !('uid' in resource.data) ?
             !('uid' in request.resource.data) :
             (request.resource.data.uid == resource.data.uid);
    }

    // Ensure specified immutable fields are not modified, added, or deleted during an update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate date string format (YYYY-MM-DD or ISO 8601) and prevent oversized inputs
    function isValidDateString(dateStr) {
      return dateStr is string &&
             dateStr.size() >= 10 &&
             dateStr.size() <= 35 &&
             dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}(.*)?$');
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validates 'incomes' document schema, types, limits and required fields
    function isValidIncome(data) {
      let allowedFields = ['id', 'description', 'amount', 'category', 'date', 'uid', 'createdAt', 'updatedAt'];
      let requiredFields = ['description', 'amount', 'date'];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.description is string &&
             data.description.size() >= 1 &&
             data.description.size() <= 100 &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 100000000 &&
             isValidDateString(data.date) &&
             (!('category' in data) || (data.category is string && data.category.size() >= 1 && data.category.size() <= 50)) &&
             (!('id' in data) || (data.id is string && data.id.size() >= 1 && data.id.size() <= 64)) &&
             (!('uid' in data) || (data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40))) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() <= 40)));
    }

    // Validates 'expenses' document schema, types, limits and required fields
    function isValidExpense(data) {
      let allowedFields = ['id', 'description', 'amount', 'dueDate', 'category', 'paid', 'paymentUrl', 'uid', 'createdAt', 'updatedAt'];
      let requiredFields = ['description', 'amount', 'dueDate'];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.description is string &&
             data.description.size() >= 1 &&
             data.description.size() <= 100 &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 100000000 &&
             isValidDateString(data.dueDate) &&
             (!('paid' in data) || data.paid is bool) &&
             (!('paymentUrl' in data) || (data.paymentUrl is string && data.paymentUrl.size() <= 500)) &&
             (!('category' in data) || (data.category is string && data.category.size() >= 1 && data.category.size() <= 50)) &&
             (!('id' in data) || (data.id is string && data.id.size() >= 1 && data.id.size() <= 64)) &&
             (!('uid' in data) || (data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40))) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() <= 40)));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Incomes Collection (Receitas domésticas)
    match /incomes/{incomeId} {
      // Allow read operations
      allow read: if isAuthorized();

      // Allow document creation with full schema validation and UID protection
      allow create: if isAuthorized() &&
                       isValidIncome(request.resource.data) &&
                       uidUnchanged();

      // Allow document updates with full schema validation and immutable field protection
      allow update: if isAuthorized() &&
                       isValidIncome(request.resource.data) &&
                       uidNotModified() &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);

      // Allow document deletion
      allow delete: if isAuthorized() &&
                       (!('uid' in resource.data) || isDocOwner() || isPrototypeMode());
    }

    // Expenses Collection (Despesas / Contas a pagar)
    match /expenses/{expenseId} {
      // Allow read operations
      allow read: if isAuthorized();

      // Allow document creation with full schema validation and UID protection
      allow create: if isAuthorized() &&
                       isValidExpense(request.resource.data) &&
                       uidUnchanged();

      // Allow document updates (e.g. marking as paid, updating value or dueDate)
      allow update: if isAuthorized() &&
                       isValidExpense(request.resource.data) &&
                       uidNotModified() &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);

      // Allow document deletion
      allow delete: if isAuthorized() &&
                       (!('uid' in resource.data) || isDocOwner() || isPrototypeMode());
    }

    // ===============================================================
    // Default Deny Rule for All Other Paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
